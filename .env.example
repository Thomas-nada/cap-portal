# Copy to .env for local development. All values are optional locally:
# with no DATABASE_URL the backend uses a local SQLite file (cap.db), and with
# no JWT_SECRET it generates a random per-process signing key.
#
# In production (a real Postgres DATABASE_URL) JWT_SECRET is REQUIRED — the
# backend refuses to start without it.

# PostgreSQL connection string. Omit to use local SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/cap_portal

# JWT signing secret. Generate with: openssl rand -hex 32
# JWT_SECRET=change-me

# Set to "production" on deployed instances.
# ENVIRONMENT=production
